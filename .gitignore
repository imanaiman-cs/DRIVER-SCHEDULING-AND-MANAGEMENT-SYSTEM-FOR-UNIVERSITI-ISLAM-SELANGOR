# Uploaded photos (keep the folders, ignore the files)
uploads/vehicles/*
uploads/drivers/*
!uploads/vehicles/.gitkeep
!uploads/drivers/.gitkeep

# Supporting documents for vehicle requests (private; keep folder + protection only)
uploads/documents/*
!uploads/documents/.htaccess
!uploads/documents/.gitkeep

# Local e-mail settings (contain the SMTP password)
config/mail.php
config/whatsapp.php

# Server settings (database password)
config/local.php

# Node (only used to build assets/css/app.css)
node_modules/

# Python bytecode from the HTTP test suites
__pycache__/
!uploads/documents/demo_supporting_letter.pdf
